# Copy to /etc/klubb1.env on the server (mode 600). Never commit the real file.
OPENAI_API_KEY=sk-...
KLUBB1_MODEL=gpt-5.6-luna
KLUBB1_DATA_DIR=/opt/klubb1/data
# Club code the mirror asks for. Leave empty to disable the gate.
KLUBB1_KODE=
# Daily caps, so a lost key or a bored bot cannot run up the bill.
KLUBB1_MAX_OPPGAVER_PER_DAG=400
KLUBB1_MAX_SPEIL_PER_DAG=2000
